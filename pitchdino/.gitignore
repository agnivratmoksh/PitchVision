# ======================================================
# PITCHVISION .gitignore
# ======================================================


# ------------------------------------------------------
# ENVIRONMENT VARIABLES / SECRETS
# ------------------------------------------------------

.env
.env.*
!.env.example

*.secret
secrets/
credentials/
*.pem
*.key


# ------------------------------------------------------
# PYTHON
# ------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so

.Python

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/

pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg


# ------------------------------------------------------
# PYTHON VIRTUAL ENVIRONMENTS
# ------------------------------------------------------

.venv/
venv/
env/
ENV/
.python-version


# ------------------------------------------------------
# JUPYTER
# ------------------------------------------------------

.ipynb_checkpoints/


# ------------------------------------------------------
# PYTORCH / MACHINE LEARNING
# ------------------------------------------------------

# Model checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# Training outputs
runs/
wandb/
mlruns/
lightning_logs/

# TensorBoard
tensorboard/
events.out.tfevents.*


# ------------------------------------------------------
# DATASETS
# ------------------------------------------------------

datasets/
dataset/
data/
raw_data/
processed_data/

*.csv
*.xls
*.xlsx
*.parquet
*.feather

# If you have small CSV files that MUST be committed,
# add an exception below:
#
# !frontend/example.csv


# ------------------------------------------------------
# GENERATED ANALYSIS OUTPUT
# ------------------------------------------------------

api_results/
results/
outputs/
output/
analysis_results/

keypoint_cache/
cache/
tmp/
temp/

*.jsonl


# ------------------------------------------------------
# IMAGES / VIDEOS
# ------------------------------------------------------

# Uploaded files
uploads/
uploaded/
user_uploads/

# Generated images
generated/
visualizations/

# Large media files
*.mp4
*.mov
*.avi
*.mkv
*.webm

*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.webp


# ------------------------------------------------------
# NODE.JS
# ------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo

.nyc_output/
coverage/

*.tgz


# ------------------------------------------------------
# NODE BUILD OUTPUT
# ------------------------------------------------------

dist/
build/
.next/
.nuxt/
.output/
.cache/


# ------------------------------------------------------
# CLOUD / DEPLOYMENT
# ------------------------------------------------------

.cloudflare/
cloudflared/
.tunnel/
*.log


# ------------------------------------------------------
# PM2
# ------------------------------------------------------

.pm2/
pids/
logs/

*.pid


# ------------------------------------------------------
# LOG FILES
# ------------------------------------------------------

*.log
logs/


# ------------------------------------------------------
# MACOS
# ------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
.idea/
*.swp
*.swo

Icon

._*

.Spotlight-V100
.Trashes
.fseventsd


# ------------------------------------------------------
# WINDOWS
# ------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db

Desktop.ini


# ------------------------------------------------------
# LINUX
# ------------------------------------------------------

.directory


# ------------------------------------------------------
